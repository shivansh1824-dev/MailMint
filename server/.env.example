# App
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# Supabase (Leave empty for intelligent local offline/dev storage mode)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=resumes

# Auth
JWT_SECRET=mailmint_super_secret_access_jwt_key_2026_forge
JWT_REFRESH_SECRET=mailmint_super_secret_refresh_jwt_key_2026_forge
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Encryption (32-byte hex for AES-256-CBC)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# AI (When empty, high-fidelity mock AI mode is used)
AI_API_KEY=
AI_MODEL=claude-sonnet-4-6
AI_BASE_URL=https://api.anthropic.com

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/integrations/gmail/callback

# SMTP fallback
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Cron
DAILY_DIGEST_CRON=0 8 * * *
DEFAULT_TIMEZONE=Asia/Kolkata

# Limits
MAX_UPLOAD_SIZE_MB=5
MAX_CONTACTS_FREE_PLAN=100
MAX_EMAILS_PER_DAY_FREE=10
