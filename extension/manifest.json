{
  "manifest_version": 3,
  "name": "MailMint Clipper",
  "version": "1.0.0",
  "description": "1-click recruiter & hiring lead clipper for MailMint. Extract profiles from LinkedIn and send straight to your outreach pipeline.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "MailMint Clipper"
  },
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://*.linkedin.com/*",
    "http://localhost:5000/*",
    "http://localhost:5173/*",
    "https://mail-mint-puce.vercel.app/*",
    "https://mailmint-ulsd.onrender.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://*.linkedin.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
